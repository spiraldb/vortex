query TT
EXPLAIN (FORMAT json)
select
            100.00 * sum(case
                             when p_type like 'PROMO%'
                                 then l_extendedprice * (1 - l_discount)
                             else 0
            end) / sum(l_extendedprice * (1 - l_discount)) as promo_revenue
from
    lineitem,
    part
where
        l_partkey = p_partkey
  and l_shipdate >= date '1995-09-01'
  and l_shipdate < date '1995-10-01';
----
logical_plan
01)PROJECTION: expressions=promo_revenue
02)--AGGREGATE: expressions=[sum(CASE  WHEN ((p_type ~~ 'PROMO%')) THEN ((l_extendedprice * (CAST(1 AS DECIMAL(16,2)) - l_discount))) ELSE CAST(0 AS DECIMAL(18,4)) END), sum((l_extendedprice * (CAST(1 AS DECIMAL(16,2)) - l_discount)))]
03)----FILTER: expressions=[(l_partkey = p_partkey), (l_shipdate >= CAST('1995-09-01' AS DATE)), (l_shipdate < CAST('1995-10-01' AS DATE))]
04)------CROSS_PRODUCT
05)--------PROJECTION: expressions=[l_orderkey, l_partkey, l_suppkey, l_linenumber, l_quantity, l_extendedprice, l_discount, l_tax, l_returnflag, l_linestatus, l_shipdate, l_commitdate, l_receiptdate, l_shipinstruct, l_shipmode, l_comment]
06)----------READ_VORTEX: function=Vortex Scan
07)--------PROJECTION: expressions=[p_partkey, p_name, p_mfgr, p_brand, p_type, p_size, p_container, p_retailprice, p_comment]
08)----------READ_VORTEX: function=Vortex Scan
logical_opt
01)PROJECTION: expressions=promo_revenue, estimated_cardinality=1
02)--AGGREGATE: expressions=[sum(CASE  WHEN (prefix(p_type, 'PROMO')) THEN ((l_extendedprice * (1.00 - l_discount))) ELSE 0.0000 END), sum((l_extendedprice * (1.00 - l_discount)))], estimated_cardinality=1
03)----COMPARISON_JOIN: join_type=INNER, conditions=(l_partkey = p_partkey), estimated_cardinality=120114
04)------PROJECTION: expressions=[l_partkey, l_extendedprice, l_discount], estimated_cardinality=120114
05)--------READ_VORTEX: filters=(1995-09-01 <= $.l_shipdate < 1995-10-01), function=Vortex Scan, estimated_cardinality=120114
06)------PROJECTION: expressions=[p_partkey, p_type], estimated_cardinality=20000
07)--------READ_VORTEX: function=Vortex Scan, estimated_cardinality=20000
physical_plan
01)PROJECTION: projections=promo_revenue, estimated_cardinality=1
02)--UNGROUPED_AGGREGATE: aggregates=[sum(#0), sum(#1)]
03)----PROJECTION: projections=[CASE  WHEN (prefix(p_type, 'PROMO')) THEN ((l_extendedprice * (1.00 - l_discount))) ELSE 0.0000 END, (l_extendedprice * (1.00 - l_discount))], estimated_cardinality=120114
04)------HASH_JOIN: join_type=INNER, conditions=l_partkey = p_partkey, estimated_cardinality=120114
05)--------READ_VORTEX: function=Vortex Scan, filters=(1995-09-01 <= $.l_shipdate < 1995-10-01), projections=[l_partkey, l_extendedprice, l_discount], estimated_cardinality=120114
06)--------READ_VORTEX: function=Vortex Scan, projections=[p_partkey, p_type], estimated_cardinality=20000
