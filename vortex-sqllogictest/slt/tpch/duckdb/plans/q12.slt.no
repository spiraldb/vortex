query TT
EXPLAIN (FORMAT json)
select
    l_shipmode,
    sum(case
            when o_orderpriority = '1-URGENT'
                or o_orderpriority = '2-HIGH'
                then 1
            else 0
        end) as high_line_count,
    sum(case
            when o_orderpriority <> '1-URGENT'
                and o_orderpriority <> '2-HIGH'
                then 1
            else 0
        end) as low_line_count
from
    lineitem
        join
    orders
    on
            l_orderkey = o_orderkey
where
        l_shipmode in ('MAIL', 'SHIP')
  and l_commitdate < l_receiptdate
  and l_shipdate < l_commitdate
  and l_receiptdate >= date '1994-01-01'
  and l_receiptdate < date '1995-01-01'
group by
    l_shipmode
order by
    l_shipmode;
----
logical_plan
01)ORDER_BY: order_by=memory.main.lineitem.l_shipmode
02)--PROJECTION: expressions=[l_shipmode, high_line_count, low_line_count]
03)----AGGREGATE: groups=l_shipmode, expressions=[sum(CASE  WHEN (((o_orderpriority = CAST('1-URGENT' AS VARCHAR)) OR (o_orderpriority = CAST('2-HIGH' AS VARCHAR)))) THEN (CAST(1 AS INTEGER)) ELSE CAST(0 AS INTEGER) END), sum(CASE  WHEN (((o_orderpriority != CAST('1-URGENT' AS VARCHAR)) AND (o_orderpriority != CAST('2-HIGH' AS VARCHAR)))) THEN (CAST(1 AS INTEGER)) ELSE CAST(0 AS INTEGER) END)]
04)------FILTER: expressions=[(l_shipmode IN (CAST('MAIL' AS VARCHAR), CAST('SHIP' AS VARCHAR))), (l_commitdate < l_receiptdate), (l_shipdate < l_commitdate), (l_receiptdate >= CAST('1994-01-01' AS DATE)), (l_receiptdate < CAST('1995-01-01' AS DATE))]
05)--------COMPARISON_JOIN: join_type=INNER, conditions=(l_orderkey = o_orderkey)
06)----------PROJECTION: expressions=[l_orderkey, l_partkey, l_suppkey, l_linenumber, l_quantity, l_extendedprice, l_discount, l_tax, l_returnflag, l_linestatus, l_shipdate, l_commitdate, l_receiptdate, l_shipinstruct, l_shipmode, l_comment]
07)------------READ_VORTEX: function=Vortex Scan
08)----------PROJECTION: expressions=[o_orderkey, o_custkey, o_orderstatus, o_totalprice, o_orderdate, o_orderpriority, o_clerk, o_shippriority, o_comment]
09)------------READ_VORTEX: function=Vortex Scan
