query TT
EXPLAIN (FORMAT json)
select
    l_returnflag,
    l_linestatus,
    sum(l_quantity) as sum_qty,
    sum(l_extendedprice) as sum_base_price,
    sum(l_extendedprice * (1 - l_discount)) as sum_disc_price,
    sum(l_extendedprice * (1 - l_discount) * (1 + l_tax)) as sum_charge,
    avg(l_quantity) as avg_qty,
    avg(l_extendedprice) as avg_price,
    avg(l_discount) as avg_disc,
    count(*) as count_order
from
    lineitem
where
        l_shipdate <= date '1998-09-02'
group by
    l_returnflag,
    l_linestatus
order by
    l_returnflag,
	l_linestatus;
----
logical_plan
01)ORDER_BY: order_by=[memory.main.lineitem.l_returnflag, memory.main.lineitem.l_linestatus]
02)--PROJECTION: expressions=[l_returnflag, l_linestatus, sum_qty, sum_base_price, sum_disc_price, sum_charge, avg_qty, avg_price, avg_disc, count_order]
03)----AGGREGATE: groups=[l_returnflag, l_linestatus], expressions=[sum(l_quantity), sum(l_extendedprice), sum((l_extendedprice * (CAST(1 AS DECIMAL(16,2)) - l_discount))), sum(((l_extendedprice * (CAST(1 AS DECIMAL(16,2)) - l_discount)) * (CAST(1 AS DECIMAL(16,2)) + l_tax))), avg(l_quantity), avg(l_extendedprice), avg(l_discount), count_star()]
04)------FILTER: expressions=(l_shipdate <= CAST('1998-09-02' AS DATE))
05)--------PROJECTION: expressions=[l_orderkey, l_partkey, l_suppkey, l_linenumber, l_quantity, l_extendedprice, l_discount, l_tax, l_returnflag, l_linestatus, l_shipdate, l_commitdate, l_receiptdate, l_shipinstruct, l_shipmode, l_comment]
06)----------READ_VORTEX: function=Vortex Scan
logical_opt
01)ORDER_BY: order_by=[memory.main.lineitem.l_returnflag, memory.main.lineitem.l_linestatus]
02)--PROJECTION: expressions=[l_returnflag, l_linestatus, sum_qty, sum_base_price, sum_disc_price, sum_charge, avg_qty, avg_price, avg_disc, count_order], estimated_cardinality=120113
03)----AGGREGATE: groups=[l_returnflag, l_linestatus], expressions=[sum(l_quantity), sum(l_extendedprice), sum(#4), sum((#4 * (1.00 + l_tax))), avg(l_quantity), avg(l_extendedprice), avg(l_discount), count_star()], estimated_cardinality=120113
04)------PROJECTION: expressions=[l_returnflag, l_linestatus, l_quantity, l_extendedprice, (l_extendedprice * (1.00 - l_discount)), l_tax, l_discount], estimated_cardinality=120114
05)--------PROJECTION: expressions=[l_quantity, l_extendedprice, l_discount, l_tax, l_returnflag, l_linestatus], estimated_cardinality=120114
06)----------READ_VORTEX: filters=($.l_shipdate <= 1998-09-02), function=Vortex Scan, estimated_cardinality=120114
physical_plan
01)ORDER_BY: order_by=[memory.main.lineitem.l_returnflag ASC, memory.main.lineitem.l_linestatus ASC]
02)--HASH_GROUP_BY: groups=[#0, #1], aggregates=[sum(#2), sum(#3), sum(#4), sum(#5), avg(#6), avg(#7), avg(#8), count_star()], estimated_cardinality=120113
03)----PROJECTION: projections=[l_returnflag, l_linestatus, l_quantity, l_extendedprice, #4, (#4 * (1.00 + l_tax)), l_quantity, l_extendedprice, l_discount], estimated_cardinality=120114
04)------PROJECTION: projections=[l_returnflag, l_linestatus, l_quantity, l_extendedprice, (l_extendedprice * (1.00 - l_discount)), l_tax, l_discount], estimated_cardinality=120114
05)--------READ_VORTEX: function=Vortex Scan, filters=($.l_shipdate <= 1998-09-02), projections=[l_quantity, l_extendedprice, l_discount, l_tax, l_returnflag, l_linestatus], estimated_cardinality=120114
