query TT
EXPLAIN (FORMAT json)
select
    o_orderpriority,
    count(*) as order_count
from
    orders
where
        o_orderdate >= date '1993-07-01'
  and o_orderdate < date '1993-07-01' + interval '3' month
  and exists (
        select
            *
        from
            lineitem
        where
                l_orderkey = o_orderkey
          and l_commitdate < l_receiptdate
    )
group by
    o_orderpriority
order by
    o_orderpriority;
----
logical_plan
01)ORDER_BY: order_by=memory.main.orders.o_orderpriority
02)--PROJECTION: expressions=[o_orderpriority, order_count]
03)----AGGREGATE: groups=o_orderpriority, expressions=count_star()
04)------FILTER: expressions=[(o_orderdate >= CAST('1993-07-01' AS DATE)), (CAST(o_orderdate AS TIMESTAMP) < (CAST('1993-07-01' AS DATE) + to_months(CAST(trunc(CAST('3' AS DOUBLE)) AS INTEGER)))), SUBQUERY]
05)--------DEPENDENT_JOIN: join_type=MARK
06)----------PROJECTION: expressions=[o_orderkey, o_custkey, o_orderstatus, o_totalprice, o_orderdate, o_orderpriority, o_clerk, o_shippriority, o_comment]
07)------------READ_VORTEX: function=Vortex Scan
08)----------PROJECTION: expressions=[l_orderkey, l_partkey, l_suppkey, l_linenumber, l_quantity, l_extendedprice, l_discount, l_tax, l_returnflag, l_linestatus, l_shipdate, l_commitdate, l_receiptdate, l_shipinstruct, l_shipmode, l_comment]
09)------------FILTER: expressions=[(l_orderkey = o_orderkey), (l_commitdate < l_receiptdate)]
10)--------------PROJECTION: expressions=[l_orderkey, l_partkey, l_suppkey, l_linenumber, l_quantity, l_extendedprice, l_discount, l_tax, l_returnflag, l_linestatus, l_shipdate, l_commitdate, l_receiptdate, l_shipinstruct, l_shipmode, l_comment]
11)----------------READ_VORTEX: function=Vortex Scan
