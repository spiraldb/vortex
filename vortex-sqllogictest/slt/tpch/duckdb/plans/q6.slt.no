query TT
EXPLAIN (FORMAT json)
select
    sum(l_extendedprice * l_discount) as revenue
from
    lineitem
where
        l_shipdate >= date '1994-01-01'
  and l_shipdate < date '1995-01-01'
  and l_discount between 0.06 - 0.01 and 0.06 + 0.01
  and l_quantity < 24;
----
logical_plan
01)PROJECTION: expressions=revenue
02)--AGGREGATE: expressions=sum((l_extendedprice * l_discount))
03)----FILTER: expressions=[(l_shipdate >= CAST('1994-01-01' AS DATE)), (l_shipdate < CAST('1995-01-01' AS DATE)), (l_discount >= CAST((0.06 - 0.01) AS DECIMAL(15,2))), (l_quantity < CAST(24 AS DECIMAL(15,2))), (l_discount <= CAST((0.06 + 0.01) AS DECIMAL(15,2)))]
04)------PROJECTION: expressions=[l_orderkey, l_partkey, l_suppkey, l_linenumber, l_quantity, l_extendedprice, l_discount, l_tax, l_returnflag, l_linestatus, l_shipdate, l_commitdate, l_receiptdate, l_shipinstruct, l_shipmode, l_comment]
05)--------READ_VORTEX: function=Vortex Scan
logical_opt
01)PROJECTION: expressions=revenue, estimated_cardinality=1
02)--AGGREGATE: expressions=sum((l_extendedprice * l_discount)), estimated_cardinality=1
03)----PROJECTION: expressions=[l_extendedprice, l_discount], estimated_cardinality=120114
04)------READ_VORTEX: filters=[(1994-01-01 <= $.l_shipdate < 1995-01-01), (decimal128(5, precision=15, scale=2) <= $.l_discount <= decimal128(7, precision=15, scale=2)), ($.l_quantity < decimal128(2400, precision=15, scale=2))], function=Vortex Scan, estimated_cardinality=120114
physical_plan
01)UNGROUPED_AGGREGATE: aggregates=sum(#0)
02)--PROJECTION: projections=(l_extendedprice * l_discount), estimated_cardinality=120114
03)----READ_VORTEX: function=Vortex Scan, filters=[(1994-01-01 <= $.l_shipdate < 1995-01-01), (decimal128(5, precision=15, scale=2) <= $.l_discount <= decimal128(7, precision=15, scale=2)), ($.l_quantity < decimal128(2400, precision=15, scale=2))], projections=[l_extendedprice, l_discount], estimated_cardinality=120114
