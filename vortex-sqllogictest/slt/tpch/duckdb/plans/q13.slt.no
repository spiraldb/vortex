05)--------PROJECTION: expressions=[__internal_decompress_integral_bigint(#0, 1), #1], estimated_cardinality=12969
06)----------AGGREGATE: groups=c_custkey, expressions=count(o_orderkey), estimated_cardinality=12969
07)------------PROJECTION: expressions=[#0, __internal_compress_integral_usmallint(#1, 1)], estimated_cardinality=30000
08)--------------COMPARISON_JOIN: join_type=RIGHT, conditions=(o_custkey = c_custkey), estimated_cardinality=30000
