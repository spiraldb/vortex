query TT
EXPLAIN (FORMAT json)
select
    c_count,
    count(*) as custdist
from
    (
        select
            c_custkey,
            count(o_orderkey)
        from
            customer left outer join orders on
                        c_custkey = o_custkey
                    and o_comment not like '%special%requests%'
        group by
            c_custkey
    ) as c_orders (c_custkey, c_count)
group by
    c_count
order by
    custdist desc,
    c_count desc;
----
logical_plan
01)ORDER_BY: order_by=[count_star(), c_orders.c_count]
02)--PROJECTION: expressions=[c_count, custdist]
03)----AGGREGATE: groups=c_count, expressions=count_star()
04)------PROJECTION: expressions=[c_custkey, count(o_orderkey)]
05)--------AGGREGATE: groups=c_custkey, expressions=count(o_orderkey)
06)----------COMPARISON_JOIN: join_type=LEFT, conditions=(c_custkey = o_custkey)
07)------------PROJECTION: expressions=[c_custkey, c_name, c_address, c_nationkey, c_phone, c_acctbal, c_mktsegment, c_comment]
08)--------------READ_VORTEX: function=Vortex Scan
09)------------FILTER: expressions=(o_comment !~~ '%special%requests%')
10)--------------PROJECTION: expressions=[o_orderkey, o_custkey, o_orderstatus, o_totalprice, o_orderdate, o_orderpriority, o_clerk, o_shippriority, o_comment]
11)----------------READ_VORTEX: function=Vortex Scan
