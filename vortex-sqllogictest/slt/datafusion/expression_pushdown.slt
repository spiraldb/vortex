include ../setup.slt.no

statement ok
SET vortex.projection_pushdown = true;

statement ok
COPY (SELECT * FROM (VALUES
    (1, 0, TRUE),
    (2, 2, FALSE),
    (3, 4, NULL),
    (4, NULL, FALSE),
    (5, -2, TRUE)
) AS t(id, divisor, flag)) TO '${WORK_DIR}/expressions.vortex';

statement ok
CREATE EXTERNAL TABLE expressions STORED AS vortex LOCATION '${WORK_DIR}/expressions.vortex';

# Guarded division must run in the scan without evaluating zero divisors.
query TT
EXPLAIN SELECT id FROM expressions
WHERE CASE WHEN divisor <> 0 THEN 12 / divisor ELSE 0 END > 2;
----
logical_plan
01)Projection: expressions.id
02)--Filter: CASE WHEN expressions.divisor != Int64(0) THEN Int64(12) / expressions.divisor ELSE Int64(0) END > Int64(2)
03)----TableScan: expressions projection=[id, divisor], partial_filters=[CASE WHEN expressions.divisor != Int64(0) THEN Int64(12) / expressions.divisor ELSE Int64(0) END > Int64(2)]
physical_plan DataSourceExec: file_groups={1 group: [[${WORK_DIR}/expressions.vortex]]}, projection=[id], file_type=vortex, predicate: CASE WHEN divisor@1 != 0 THEN 12 / divisor@1 ELSE 0 END > 2

query I
SELECT id FROM expressions
WHERE CASE WHEN divisor <> 0 THEN 12 / divisor ELSE 0 END > 2
ORDER BY id;
----
2
3

# NOT must be accepted as an exact predicate, including SQL null semantics.
query TT
EXPLAIN SELECT id FROM expressions WHERE NOT flag;
----
logical_plan
01)Projection: expressions.id
02)--Filter: NOT expressions.flag
03)----TableScan: expressions projection=[id, flag], partial_filters=[NOT expressions.flag]
physical_plan DataSourceExec: file_groups={1 group: [[${WORK_DIR}/expressions.vortex]]}, projection=[id], file_type=vortex, predicate: NOT flag@2

query I
SELECT id FROM expressions WHERE NOT flag ORDER BY id;
----
2
4

# An unsupported child keeps the whole CASE filter in DataFusion.
query TT
EXPLAIN SELECT id FROM expressions
WHERE CASE WHEN divisor <> 0 THEN 12 % divisor ELSE 0 END = 0;
----
logical_plan
01)Projection: expressions.id
02)--Filter: CASE WHEN expressions.divisor != Int64(0) THEN Int64(12) % expressions.divisor ELSE Int64(0) END = Int64(0)
03)----TableScan: expressions projection=[id, divisor], partial_filters=[CASE WHEN expressions.divisor != Int64(0) THEN Int64(12) % expressions.divisor ELSE Int64(0) END = Int64(0)]
physical_plan
01)FilterExec: CASE WHEN divisor@1 != 0 THEN 12 % divisor@1 ELSE 0 END = 0, projection=[id@0]
02)--DataSourceExec: file_groups={1 group: [[${WORK_DIR}/expressions.vortex]]}, projection=[id, divisor], file_type=vortex

query I
SELECT id FROM expressions
WHERE CASE WHEN divisor <> 0 THEN 12 % divisor ELSE 0 END = 0
ORDER BY id;
----
1
2
3
4
5
