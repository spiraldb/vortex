include ../setup.slt.no

statement ok
COPY (
    WITH cte AS (
        SELECT generate_series AS i FROM generate_series(100000))
    SELECT (CASE WHEN i > 0 THEN i::INTEGER ELSE NULL END) AS i FROM cte
)
TO '${WORK_DIR}/agg_partition_stats.vortex';

query TT
EXPLAIN SELECT count(*)
FROM '${WORK_DIR}/agg_partition_stats.vortex';
----
<REGEX>:.*COLUMN_DATA_SCAN.*

query TT
EXPLAIN SELECT count(*)
FROM '${WORK_DIR}/agg_partition_stats.vortex';
----
<!REGEX>:.*(READ_VORTEX|AGGREGATE).*

query I
SELECT count(*)
FROM '${WORK_DIR}/agg_partition_stats.vortex';
----
100001

query TT
EXPLAIN SELECT min(i), max(i)
FROM '${WORK_DIR}/agg_partition_stats.vortex';
----
<REGEX>:.*COLUMN_DATA_SCAN.*

query TT
EXPLAIN SELECT min(i), max(i)
FROM '${WORK_DIR}/agg_partition_stats.vortex';
----
<!REGEX>:.*(READ_VORTEX|AGGREGATE).*

query II
SELECT min(i), max(i) FROM '${WORK_DIR}/agg_partition_stats.vortex';
----
1 100000

query III
SELECT count(*), min(i), max(i)
FROM '${WORK_DIR}/agg_partition_stats.vortex';
----
100001 1 100000

statement ok
COPY (
    SELECT DATE '2013-07-01' + ((i % 30)::INTEGER) AS d
    FROM generate_series(1, 5000) t(i))
TO '${WORK_DIR}/agg_partition_stats-date.vortex';

query TT
EXPLAIN SELECT min(d), max(d)
FROM '${WORK_DIR}/agg_partition_stats-date.vortex';
----
<REGEX>:.*COLUMN_DATA_SCAN.*

query DD
SELECT min(d), max(d) FROM '${WORK_DIR}/agg_partition_stats-date.vortex';
----
2013-07-01 2013-07-30

statement ok
COPY (SELECT i::DOUBLE AS x FROM generate_series(1, 5000) t(i))
TO '${WORK_DIR}/agg_partition_stats-double.vortex';

query TT
EXPLAIN SELECT max(x) FROM '${WORK_DIR}/agg_partition_stats-double.vortex';
----
<REGEX>:.*COLUMN_DATA_SCAN.*

query R
SELECT max(x) FROM '${WORK_DIR}/agg_partition_stats-double.vortex';
----
5000

statement ok
COPY (SELECT CASE WHEN i = 2500 THEN 'nan'::DOUBLE ELSE i::DOUBLE END AS x FROM generate_series(1, 5000) t(i))
TO '${WORK_DIR}/agg_partition_stats-double-nan.vortex';

query TT
EXPLAIN SELECT min(x), max(x) FROM '${WORK_DIR}/agg_partition_stats-double-nan.vortex';
----
<REGEX>:.*COLUMN_DATA_SCAN.*

query RR
SELECT min(x), max(x) FROM '${WORK_DIR}/agg_partition_stats-double-nan.vortex';
----
1 NaN

query TT
EXPLAIN SELECT count(*) FROM '${WORK_DIR}/agg_partition_stats.vortex'
WHERE i > 50000;
----
<REGEX>:.*READ_VORTEX.*

query I
SELECT count(*) FROM '${WORK_DIR}/agg_partition_stats.vortex'
WHERE i > 50000;
----
50000
