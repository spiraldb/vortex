# The upstream query leaves the order of tied rows unspecified, so this record adds
# tie-breaking ORDER BY columns. plans/q13.slt.no explains the upstream query unchanged.
query TI
SELECT "SearchPhrase", COUNT(DISTINCT "UserID") AS u FROM hits WHERE "SearchPhrase" <> '' GROUP BY "SearchPhrase" ORDER BY u DESC, "SearchPhrase" LIMIT 10;
