# The upstream query leaves the order of tied rows unspecified, so this record adds
# tie-breaking ORDER BY columns. plans/q28.slt.no explains the upstream query unchanged.
# `control substitution on` (see setup.slt.no) treats `\` as an escape and `$` as a
# variable, so both are escaped here; the engine receives the upstream `\.`, `$` and `\1`.
query TRIT
SELECT REGEXP_REPLACE("Referer", '^https?://(?:www\\.)?([^/]+)/.*\$', '\\1') AS k, AVG(OCTET_LENGTH("Referer")) AS l, COUNT(*) AS c, MIN("Referer") FROM hits WHERE "Referer" <> '' GROUP BY k HAVING COUNT(*) > 100000 ORDER BY l DESC, k LIMIT 25;
----
