# The upstream query leaves the order of tied rows unspecified, so this record adds
# tie-breaking ORDER BY columns. plans/q17.slt.no explains the upstream query unchanged.
query ITI
SELECT "UserID", "SearchPhrase", COUNT(*) FROM hits GROUP BY "UserID", "SearchPhrase" ORDER BY "UserID", "SearchPhrase" LIMIT 10;
