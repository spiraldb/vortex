query TT
EXPLAIN
SELECT AVG("UserID") FROM hits;
----
logical_plan
01)Aggregate: groupBy=[[]], aggr=[[avg(CAST(hits.UserID AS Float64))]]
02)--TableScan: hits projection=[UserID]
physical_plan
01)AggregateExec: mode=Final, gby=[], aggr=[avg(hits.UserID)]
02)--CoalescePartitionsExec
03)----AggregateExec: mode=Partial, gby=[], aggr=[avg(hits.UserID)]
04)------DataSourceExec: file_groups={4 groups: [[${WORK_DIR}/hits.vortex:<slt:ignore>], [${WORK_DIR}/hits.vortex:<slt:ignore>], [${WORK_DIR}/hits.vortex:<slt:ignore>], [${WORK_DIR}/hits.vortex:<slt:ignore>]]}, projection=[UserID], file_type=vortex
