# The upstream query leaves the order of tied rows unspecified, so this record adds
# tie-breaking ORDER BY columns. plans/q10.slt.no explains the upstream query unchanged.
query TI
SELECT "MobilePhoneModel", COUNT(DISTINCT "UserID") AS u FROM hits WHERE "MobilePhoneModel" <> '' GROUP BY "MobilePhoneModel" ORDER BY u DESC, "MobilePhoneModel" LIMIT 10;
----
