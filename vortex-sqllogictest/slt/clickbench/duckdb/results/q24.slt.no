# The upstream query leaves the order of tied rows unspecified, so this record adds
# tie-breaking ORDER BY columns. plans/q24.slt.no explains the upstream query unchanged.
query T
SELECT "SearchPhrase" FROM hits WHERE "SearchPhrase" <> '' ORDER BY "EventTime", "SearchPhrase" LIMIT 10;
