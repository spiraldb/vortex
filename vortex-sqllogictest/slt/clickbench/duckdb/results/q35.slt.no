# The upstream query leaves the order of tied rows unspecified, so this record adds
# tie-breaking ORDER BY columns. plans/q35.slt.no explains the upstream query unchanged.
query IIIII
SELECT "ClientIP", "ClientIP" - 1, "ClientIP" - 2, "ClientIP" - 3, COUNT(*) AS c FROM hits GROUP BY "ClientIP", "ClientIP" - 1, "ClientIP" - 2, "ClientIP" - 3 ORDER BY c DESC, "ClientIP" LIMIT 10;
