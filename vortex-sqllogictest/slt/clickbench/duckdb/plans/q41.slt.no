01)LIMIT
02)--ORDER_BY: order_by=count_star(), estimated_cardinality=39999
03)----PROJECTION: expressions=[WindowClientWidth, WindowClientHeight, PageViews], estimated_cardinality=39999
04)------AGGREGATE: groups=[WindowClientWidth, WindowClientHeight], expressions=count_star(), estimated_cardinality=39999
05)--------PROJECTION: expressions=[WindowClientWidth, WindowClientHeight], estimated_cardinality=40000
06)----------READ_VORTEX: filters=[($.CounterID = 62i32), (2013-07-01T00:00:00Z <= $.EventDate <= 2013-07-31T00:00:00Z), ($.IsRefresh = 0i16), ($.DontCountHits = 0i16), ($.URLHash = 2868770270353813622i64)], function=Vortex Scan, estimated_cardinality=40000
