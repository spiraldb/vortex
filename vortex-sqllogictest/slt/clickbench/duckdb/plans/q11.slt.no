query TT
EXPLAIN (FORMAT json)
SELECT "MobilePhone", "MobilePhoneModel", COUNT(DISTINCT "UserID") AS u FROM hits WHERE "MobilePhoneModel" <> '' GROUP BY "MobilePhone", "MobilePhoneModel" ORDER BY u DESC LIMIT 10;
----
logical_plan
01)LIMIT
02)--ORDER_BY: order_by=count(DISTINCT memory.main.hits.UserID)
03)----PROJECTION: expressions=[MobilePhone, MobilePhoneModel, u]
04)------AGGREGATE: groups=[MobilePhone, MobilePhoneModel], expressions=count(DISTINCT UserID)
05)--------FILTER: expressions=(MobilePhoneModel != CAST('' AS VARCHAR))
06)----------PROJECTION: expressions=[WatchID, JavaEnable, Title, GoodEvent, EventTime, EventDate, CounterID, ClientIP, RegionID, UserID, CounterClass, OS, UserAgent, URL, Referer, IsRefresh, RefererCategoryID, RefererRegionID, URLCategoryID, URLRegionID, ResolutionWidth, ResolutionHeight, ResolutionDepth, FlashMajor, FlashMinor, FlashMinor2, NetMajor, NetMinor, UserAgentMajor, UserAgentMinor, CookieEnable, JavascriptEnable, IsMobile, MobilePhone, MobilePhoneModel, Params, IPNetworkID, TraficSourceID, SearchEngineID, SearchPhrase, AdvEngineID, IsArtifical, WindowClientWidth, WindowClientHeight, ClientTimeZone, ClientEventTime, SilverlightVersion1, SilverlightVersion2, SilverlightVersion3, SilverlightVersion4, PageCharset, CodeVersion, IsLink, IsDownload, IsNotBounce, FUniqID, OriginalURL, HID, IsOldCounter, IsEvent, IsParameter, DontCountHits, WithHash, HitColor, LocalEventTime, Age, Sex, Income, Interests, Robotness, RemoteIP, WindowName, OpenerName, HistoryLength, BrowserLanguage, BrowserCountry, SocialNetwork, SocialAction, HTTPError, SendTiming, DNSTiming, ConnectTiming, ResponseStartTiming, ResponseEndTiming, FetchTiming, SocialSourceNetworkID, SocialSourcePage, ParamPrice, ParamOrderID, ParamCurrency, ParamCurrencyID, OpenstatServiceName, OpenstatCampaignID, OpenstatAdID, OpenstatSourceID, UTMSource, UTMMedium, UTMCampaign, UTMContent, UTMTerm, FromTag, HasGCLID, RefererHash, URLHash, CLID]
07)------------READ_VORTEX: function=Vortex Scan
logical_opt
01)TOP_N: estimated_cardinality=10
02)--PROJECTION: expressions=[MobilePhone, MobilePhoneModel, u], estimated_cardinality=199999
03)----PROJECTION: expressions=[__internal_decompress_integral_smallint(#0, 0), #1, #2], estimated_cardinality=199999
04)------AGGREGATE: groups=[MobilePhone, MobilePhoneModel], expressions=count(DISTINCT UserID), estimated_cardinality=199999
05)--------PROJECTION: expressions=[#0, __internal_compress_integral_utinyint(#1, 0), #2], estimated_cardinality=200000
06)----------PROJECTION: expressions=[UserID, MobilePhone, MobilePhoneModel], estimated_cardinality=200000
07)------------READ_VORTEX: filters=($.MobilePhoneModel != ""), function=Vortex Scan, estimated_cardinality=200000
physical_plan
01)TOP_N: top=10, order_by=count(DISTINCT memory.main.hits.UserID) DESC
02)--PROJECTION: projections=[__internal_decompress_integral_smallint(#0, 0), #1, #2], estimated_cardinality=199999
03)----HASH_GROUP_BY: groups=[#0, #1], aggregates=count(DISTINCT #2), estimated_cardinality=199999
04)------PROJECTION: projections=[MobilePhone, MobilePhoneModel, UserID], estimated_cardinality=200000
05)--------PROJECTION: projections=[#0, __internal_compress_integral_utinyint(#1, 0), #2], estimated_cardinality=200000
06)----------READ_VORTEX: function=Vortex Scan, filters=($.MobilePhoneModel != ""), projections=[UserID, MobilePhone, MobilePhoneModel], estimated_cardinality=200000
