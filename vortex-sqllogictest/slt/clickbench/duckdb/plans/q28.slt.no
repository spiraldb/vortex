# `control substitution on` (see setup.slt.no) treats `\` as an escape and `$` as a
# variable, so both are escaped here; the engine receives the upstream `\.`, `$` and `\1`.
query TT
EXPLAIN (FORMAT json)
SELECT REGEXP_REPLACE("Referer", '^https?://(?:www\\.)?([^/]+)/.*\$', '\\1') AS k, AVG(OCTET_LENGTH("Referer")) AS l, COUNT(*) AS c, MIN("Referer") FROM hits WHERE "Referer" <> '' GROUP BY k HAVING COUNT(*) > 100000 ORDER BY l DESC LIMIT 25;
----
logical_plan
01)LIMIT
02)--ORDER_BY: order_by=avg(octet_length(memory.main.hits.Referer))
03)----PROJECTION: expressions=[0, l, c, min(Referer)]
04)------FILTER: expressions=(count_star() > CAST(100000 AS BIGINT))
05)--------AGGREGATE: groups=k, expressions=[count_star(), avg(strlen(Referer)), min(Referer)]
06)----------FILTER: expressions=(Referer != CAST('' AS VARCHAR))
07)------------PROJECTION: expressions=[WatchID, JavaEnable, Title, GoodEvent, EventTime, EventDate, CounterID, ClientIP, RegionID, UserID, CounterClass, OS, UserAgent, URL, Referer, IsRefresh, RefererCategoryID, RefererRegionID, URLCategoryID, URLRegionID, ResolutionWidth, ResolutionHeight, ResolutionDepth, FlashMajor, FlashMinor, FlashMinor2, NetMajor, NetMinor, UserAgentMajor, UserAgentMinor, CookieEnable, JavascriptEnable, IsMobile, MobilePhone, MobilePhoneModel, Params, IPNetworkID, TraficSourceID, SearchEngineID, SearchPhrase, AdvEngineID, IsArtifical, WindowClientWidth, WindowClientHeight, ClientTimeZone, ClientEventTime, SilverlightVersion1, SilverlightVersion2, SilverlightVersion3, SilverlightVersion4, PageCharset, CodeVersion, IsLink, IsDownload, IsNotBounce, FUniqID, OriginalURL, HID, IsOldCounter, IsEvent, IsParameter, DontCountHits, WithHash, HitColor, LocalEventTime, Age, Sex, Income, Interests, Robotness, RemoteIP, WindowName, OpenerName, HistoryLength, BrowserLanguage, BrowserCountry, SocialNetwork, SocialAction, HTTPError, SendTiming, DNSTiming, ConnectTiming, ResponseStartTiming, ResponseEndTiming, FetchTiming, SocialSourceNetworkID, SocialSourcePage, ParamPrice, ParamOrderID, ParamCurrency, ParamCurrencyID, OpenstatServiceName, OpenstatCampaignID, OpenstatAdID, OpenstatSourceID, UTMSource, UTMMedium, UTMCampaign, UTMContent, UTMTerm, FromTag, HasGCLID, RefererHash, URLHash, CLID]
08)--------------READ_VORTEX: function=Vortex Scan
logical_opt
01)TOP_N: estimated_cardinality=25
02)--PROJECTION: expressions=[0, l, c, min(Referer)], estimated_cardinality=20000
03)----FILTER: expressions=(count_star() > 100000), estimated_cardinality=20000
04)------AGGREGATE: groups=k, expressions=[count_star(), avg(strlen(Referer)), min(Referer)], estimated_cardinality=100000
05)--------PROJECTION: expressions=Referer, estimated_cardinality=200000
06)----------READ_VORTEX: filters=($.Referer != ""), function=Vortex Scan, estimated_cardinality=200000
physical_plan
01)TOP_N: top=25, order_by=avg(octet_length(memory.main.hits.Referer)) DESC
02)--PROJECTION: projections=[0, l, c, min(Referer)], estimated_cardinality=20000
03)----FILTER: expression=(count_star() > 100000), estimated_cardinality=20000
04)------HASH_GROUP_BY: groups=#0, aggregates=[count_star(), avg(#1), min(#2)], estimated_cardinality=100000
05)--------PROJECTION: projections=[k, strlen(Referer), Referer], estimated_cardinality=200000
06)----------READ_VORTEX: function=Vortex Scan, filters=($.Referer != ""), projections=Referer, estimated_cardinality=200000
