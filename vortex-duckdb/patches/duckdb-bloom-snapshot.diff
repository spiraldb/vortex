+	// Copy a finalized filter without retaining its query's buffer allocator.
+	vector<uint64_t> CopyBits() const {
+		if (!initialized) {
+			return {};
+		}
+		vector<uint64_t> result(num_sectors);
+		for (idx_t i = 0; i < num_sectors; i++) {
+			const auto &word = *reinterpret_cast<const std::atomic<uint64_t> *>(&bf[i]);
+			result[i] = word.load(std::memory_order_relaxed);
+		}
+		return result;
+	}
