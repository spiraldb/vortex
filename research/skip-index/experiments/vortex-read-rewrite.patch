+            Arc::new(RepartitionStrategy::new(
+                zoned,
+                RepartitionWriterOptions {
+                    block_size_minimum: 0,
+                    block_len_multiple: ZONE_LEN,
+                    block_size_target: None,
+                    canonicalize: false,
+                },
+            )),
+        )
+        .build();
+    let input = data();
+    let predicate = lt(get_item("id", root(input.dtype().clone())), lit(-1i64));
