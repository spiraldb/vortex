+    #[test]
+    fn aggregate_contract_mean_exposes_struct_partial() -> VortexResult<()> {
+        let aggregate = Mean::combined().bind(PairOptions(
+            NumericalAggregateOpts::default(),
+            NumericalAggregateOpts::default(),
