diff --git i/vortex-array/src/aggregate_fn/foreign.rs w/vortex-array/src/aggregate_fn/foreign.rs
index feb07e4717..fb2e055ec6 100644
--- i/vortex-array/src/aggregate_fn/foreign.rs
+++ w/vortex-array/src/aggregate_fn/foreign.rs
@@ -124,3 +124,22 @@ pub fn new_foreign_aggregate_fn(id: AggregateFnId, metadata: Vec<u8>) -> Aggrega
     )
     .erased()
 }
+
+
+#[cfg(test)]
+mod tests {
+    use vortex_session::registry::CachedId;
+
+    use super::new_foreign_aggregate_fn;
+    use crate::aggregate_fn::AggregateFnSatisfaction;
+
+    #[test]
+    fn aggregate_contract_distinct_ids_do_not_satisfy() {
+        static LEFT: CachedId = CachedId::new("test.left");
+        static RIGHT: CachedId = CachedId::new("test.right");
+        let left = new_foreign_aggregate_fn(*LEFT, vec![1]);
+        let right = new_foreign_aggregate_fn(*RIGHT, vec![1]);
+        assert_ne!(left, right);
+        assert_eq!(left.can_satisfy(&right), AggregateFnSatisfaction::No);
+    }
+}
