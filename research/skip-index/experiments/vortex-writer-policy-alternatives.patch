+/// Selects aggregate instances after the input dtype and session are available.
+#[derive(Clone, Default)]
+pub enum ZonedAggregates {
+    /// Use the supported default pruning aggregates.
+    #[default]
+    Defaults,
+    /// Replace defaults with exactly these aggregates.
+    Replace(Arc<[AggregateFnRef]>),
+    /// Keep defaults and add these aggregates.
+    Extend(Arc<[AggregateFnRef]>),
+    /// Transform supported defaults at write time.
+    Configure(Arc<AggregateConfigurator>),
+}
+
+/// A callback that receives supported defaults and returns the requested aggregate list.
+pub type AggregateConfigurator = dyn Fn(&DType, &VortexSession, Vec<AggregateFnRef>) -> VortexResult<Vec<AggregateFnRef>>
+    + Send
+    + Sync;
+
+/// Controls an explicit request that cannot be applied to the input dtype.
+#[derive(Clone, Copy, Default)]
+pub enum UnsupportedAggregates {
+    /// Fail before consuming the field stream.
+    #[default]
+    Reject,
+    /// Omit unsupported requests and continue writing supported aggregates.
+    Omit,
+}
+
+impl ZonedAggregates {
+    fn resolve(
+        &self,
+        dtype: &DType,
+        session: &VortexSession,
+        unsupported: UnsupportedAggregates,
+    ) -> VortexResult<Vec<AggregateFnRef>> {
+        let defaults = || {
+            default_zoned_aggregate_fns(dtype, session)
+                .iter()
+                .filter(|aggregate| aggregate.state_dtype(dtype).is_some())
+                .cloned()
+                .collect::<Vec<_>>()
+        };
+
+        let (mut selected, requested) = match self {
+            Self::Defaults => (defaults(), Vec::new()),
+            Self::Replace(aggregates) => (Vec::new(), aggregates.to_vec()),
+            Self::Extend(aggregates) => (defaults(), aggregates.to_vec()),
+            Self::Configure(configure) => (Vec::new(), configure(dtype, session, defaults())?),
+        };
+
+        for aggregate in requested {
+            if aggregate.state_dtype(dtype).is_none() {
+                match unsupported {
+                    UnsupportedAggregates::Reject => vortex_bail!(
+                        "Aggregate {aggregate} requires a supported input dtype, got {dtype}"
+                    ),
+                    UnsupportedAggregates::Omit => continue,
+                }
+            }
+
+            if !selected.contains(&aggregate) {
+                selected.push(aggregate);
+            }
+        }
+
+        Ok(selected)
+    }
+}
