+        let file = write_with_strategy(&session, &input, strategy).await?;
+        let predicate = lt(get_item("id", root(input.dtype().clone())), lit(-1i64));
+        let count = file.row_count();
+        let keep = file
+            .layout_reader()?
+            .pruning_evaluation(
+                &(0..count),
+                &predicate,
+                Mask::new_true(usize::try_from(count)?),
+            )?
+            .await?;
+        assert!(keep.all_false());
+        Ok(())
+    }
