+    fn resolve_stat(
+        &self,
+        options: &Self::Options,
+        requested: &AggregateFnRef,
+        partial: crate::expr::Expression,
+    ) -> Option<(AggregateFnSatisfaction, crate::expr::Expression)> {
+        let satisfaction = self.can_satisfy(options, requested);
+        if !satisfaction.is_satisfied() {
+            return None;
+        }
+        let expression = if requested.is::<BoundedMax>() {
+            let valid = crate::expr::is_not_null(partial.clone());
+            let state = crate::expr::pack(
+                [("bound", partial), ("unknown", crate::expr::lit(false))],
+                crate::dtype::Nullability::Nullable,
+            );
+            crate::expr::mask(state, valid)
+        } else {
+            partial
+        };
+        Some((satisfaction, expression))
+    }
+
     fn partial_dtype(&self, options: &Self::Options, input_dtype: &DType) -> Option<DType> {
         self.return_dtype(options, input_dtype)
     }
